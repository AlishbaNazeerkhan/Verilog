module full_adder_tb;
reg a;
reg b
reg cin;
wire sum;
wire cout;

full_adder dut(
.a(a),
.b(b),
.cin(cin),
.sum(sum),
.cout(cout)
);

initial begin
$monitor("time= %0t, a= %0b b = %0b cin = %0b | sum = %0b carry = %0b", $time, a, b, cin, sum, cout);
a = 0; b = 0; cin = 0; #10;
a = 0; b = 0; cin = 1; #10;
a = 0; b = 1; cin = 0; #10;
a = 0; b = 1; cin = 1; #10;
a = 1; b = 0; cin = 0; #10;
a = 1; b = 0; cin = 1; #10;
a = 1; b = 1; cin = 0; #10;
a = 1; b = 1; cin = 1; #10;
$finish;
end
endmodule
