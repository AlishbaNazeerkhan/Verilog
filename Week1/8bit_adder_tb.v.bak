module adder_8bit_tb;
reg [7:0] a;
reg [7:0] b;
reg cin;
wire [7:0] sum;
wire cout;

adder_8bit dut(
.a(a),
.b(b),
.cin(cin),
.sum(sum),
.cout(cout)
);

initial begin
$monitor("time = %0t a = %0b b = %0b cin = %0b sum = %0b cout = %0b",$time, a, b, cin, sum, cout); 
a = 8d'10; b = 8d'5; cin = 1b'0; #10;
a = 8d'25; b = 8d'30; cin = 1b'0; #10;
$finish;
end
endmodule
